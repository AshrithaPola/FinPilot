# Copy to .env and fill in. docker-compose reads this file automatically.

# LLM provider for ALL reasoning calls (generation + relevance/groundedness
# checks): gemini (default, Google AI Studio free tier) or anthropic.
# The same Gemini key also serves the default embeddings (see below).
LLM_PROVIDER=gemini
GEMINI_API_KEY=your-key-here
# Only needed when LLM_PROVIDER=anthropic.
ANTHROPIC_API_KEY=

# Raw provider error text and per-request LLM usage come back from /ask
# only for admins; everyone else gets provider-neutral errors (details go
# to the server log). There is no global switch.
# Optional model overrides; empty = the provider's defaults in config.py
# (gemini: gemini-3.5-flash-lite for both,
#  anthropic: claude-opus-4-8 / claude-haiku-4-5).
# For demos, GENERATION_MODEL=gemini-3.6-flash gives stronger answers, but the
# free tier allows it only 20 requests/day (failed attempts count too).
GENERATION_MODEL=
GRADING_MODEL=
# Gemini thinking level for the relevance/groundedness checks
# (minimal|low|medium|high; empty = model default). Default: minimal.
# GRADING_THINKING_LEVEL=minimal

# Embeddings: gemini (default: gemini-embedding-2 with GEMINI_API_KEY, 1536
# dims) or local (sentence-transformers all-MiniLM-L6-v2, no key, CPU).
# Changing the provider, model or dimension means a fresh database and
# re-ingesting your documents (the backend refuses a mismatched index).
# EMBEDDING_PROVIDER=gemini
# EMBEDDING_MODEL=
# EMBEDDING_DIMENSIONS=   (default: 384 for MiniLM, 1536 for gemini-embedding-2)
# Vertex AI instead of the Gemini API key (needs billing and application
# default credentials):
# EMBEDDING_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=your-project
# GOOGLE_CLOUD_LOCATION=us-central1

# Postgres credentials (compose builds both URLs below from these).
# POSTGRES_USER owns the tables; only the one-shot `migrate` service uses
# it. The backend connects as finpilot_app, which row-level security
# applies to (it refuses to start as a superuser or owner, or with
# MIGRATION_DATABASE_URL set); the migrate step sets that role's password
# from APP_DB_PASSWORD on every run. POSTGRES_PASSWORD and APP_DB_PASSWORD
# are both required, with no defaults: compose fails without them.
POSTGRES_USER=finpilot
POSTGRES_PASSWORD=change-me
POSTGRES_DB=finpilot
APP_DB_PASSWORD=change-me-too

# Host ports (defaults 3000 web / 8000 API; change if something else owns them).
# FRONTEND_PORT=3001
# BACKEND_PORT=8001

# For running the backend OUTSIDE docker (uvicorn on the host), set:
# DATABASE_URL=postgresql+psycopg2://finpilot_app:change-me-too@localhost:5432/finpilot
# and run the migrate step first, with the owner URL given only to it:
#   MIGRATION_DATABASE_URL=postgresql+psycopg2://finpilot:change-me@localhost:5432/finpilot python migrate.py
# (Don't put MIGRATION_DATABASE_URL in this file: the backend would refuse to start.)
# (required: Postgres with the pgvector extension holds the chunks; e.g.
#  docker compose up postgres, which runs pgvector/pgvector:0.8.7-pg16)

# Firebase Auth. Every endpoint except /me and /health needs a Firebase ID
# token (Authorization: Bearer ...) from a user set up in Postgres.
# Required: tokens are only accepted for this project.
FIREBASE_PROJECT_ID=your-project-id
# Seconds of clock difference tolerated on token times (0-60, default 5).
# FIREBASE_CLOCK_SKEW_SECONDS=5
# Web config (VITE_*): public, read by the frontend build for its sign-in
# screen (from this file in dev, as build args in docker-compose).
# The service account key is NOT public: keep the file OUTSIDE this repo and
# point to it by absolute path. Required: the backend can't check sign-in
# tokens without it and refuses to start. docker-compose mounts this file
# read-only into the backend; it is never copied into an image.
# CI fails if a key file is committed.
GOOGLE_APPLICATION_CREDENTIALS=C:/secrets/finpilot-firebase-adminsdk.json
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_APP_ID=

# --- Neon (Phase 4; see README "Running on Neon") ---------------------------
# Owner URLs from the Neon console: migrations and loaders only, via
# scripts/neon.py. Never set DATABASE_URL or MIGRATION_DATABASE_URL here.
NEON_MIGRATION_DATABASE_URL=
NEON_POOLED_DATABASE_URL=
# Written by `scripts/neon.py setup`: finpilot_app on the pooled host.
NEON_APP_DATABASE_URL=
# A Neon branch's owner URL, for experiments (`scripts/neon.py --branch ...`).
NEON_BRANCH_DATABASE_URL=

# --- SEC EDGAR (Phase 5): "FinPilot research project <name> <email>" ---------
SEC_USER_AGENT=

# --- Market data (bank/market.py; free keys, never committed) ---------------
# Alpha Vantage: daily closes of the demo ETFs (25 requests a day, personal use).
ALPHA_VANTAGE_API_KEY=
# FRED: prime rate, fed funds, 10-year Treasury.
FRED_API_KEY=

# The engine's "today" for the synthetic data ("this month", as-of dates).
# DEMO_TODAY=2026-06-30

# Seconds per LLM or embedding call, retries included (one slow call cannot hang a request).
# LLM_CALL_TIMEOUT_S=45

# --- Tuning (every other setting config.py reads; the defaults are shown) ---
# Owner URL for the migrate step only (migrate.py); the app never uses it.
# MIGRATION_DATABASE_URL=
# Attempts per LLM or embedding call on rate-limit and overloaded errors.
# LLM_MAX_ATTEMPTS=5
# Seconds before one attempt is abandoned and retried.
# LLM_REQUEST_TIMEOUT_S=60
# Texts per Gemini embedding request.
# EMBEDDING_BATCH_SIZE=100
# Search legs: "hybrid" (vectors + full text + question index) or "dense".
# RETRIEVAL_MODE=hybrid
# Chunks handed to the model after fusion and reranking.
# TOP_K=6
# Candidates taken from each search leg before fusion.
# RRF_CANDIDATES=12
# Reciprocal-rank-fusion damping constant.
# RRF_K=60
# Rerank the fused candidates with the local cross-encoder (off in CI tests).
# RERANK=true
# The cross-encoder (ONNX, through fastembed).
# RERANK_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
# Fused candidates the cross-encoder scores.
# RERANK_CANDIDATES=20
# Return each hit's parent section in place of the chunk alone.
# PARENT_EXPANSION=false
# Token cap of an expanded parent section.
# PARENT_MAX_TOKENS=1500
# Page-based chunking of unstructured text: chunk size and overlap, in tokens.
# CHUNK_SIZE_TOKENS=600
# CHUNK_OVERLAP_TOKENS=90
# Longest question accepted, in characters.
# MAX_QUERY_CHARS=2000
# Most pages read from one PDF.
# MAX_PAGES=300
